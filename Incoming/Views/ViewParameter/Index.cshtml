<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
<style>
    th {
        text-align: center;
        vertical-align: middle;
        color: white;
    }
    tbody{
        text-align:center;
    }
</style>
<h1>Parametros</h1>

<table class="table table-hover table-bordered cell-border" id="DataTable">
    <thead>
        <tr>
            <th rowspan="2" class="bg-black text-md-center" >
                Programa
            </th>
            <th colspan="2" class="bg-primary text-md-center">
                Heater
            </th>
            <th colspan="2" class="bg-warning text-md-center">
                NTC
            </th>
            <th colspan="2" class="bg-success text-md-center">
                Inside
            </th>
            <th colspan="2" class="bg-info text-md-center">
                Outside
            </th>
            <th colspan="2" class="bg-secondary text-md-center">
                Guard
            </th>
           



        </tr>
        <tr>
            <th class="text-secondary">
                Min
            </th>
            <th class="text-danger">
                Max
            </th>
            <th class="text-secondary">
                Min
            </th>
            <th class="text-danger">
                Max
            </th>
            <th class="text-secondary">
                Min
            </th>
            <th class="text-danger">
                Max
            </th>
            <th class="text-secondary">
                Min
            </th>
            <th class="text-danger">
                Max
            </th>
            <th class="text-secondary">
                Min
            </th>
            <th class="text-danger">
                Max
            </th>



        </tr>
        
    </thead>
    <tbody>
    </tbody>
</table>

<div class="modal fade" id="CreateParameterModal" tabindex="-1" role="dialog" aria-labelledby="DatePickerModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="DatePickerModalLabel">Crear parametros</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <form>

                    <div class="form-group  mb-3">
                        <label for="Program">Nombre programa:</label>
                        <input type="text" class="form-control" id="AddProgram" style="text-transform: uppercase;">
                    </div>



                    <!-- HEADER -->
                    <div class="form-group mb-3">
                        <label class="form-label fw-bold">HEADER</label>
                        <div class="d-flex gap-2">
                            <div class="flex-fill">
                                <label for="MinHeader" class="form-label">Mínimo</label>
                                <input type="text" class="form-control" id="AddMinHEATER">
                            </div>
                            <div class="flex-fill">
                                <label for="MaxHeader" class="form-label">Máximo</label>
                                <input type="text" class="form-control" id="AddMaxHEATER">
                            </div>
                        </div>
                    </div>

                    <!-- NTC -->
                    <div class="form-group mb-3">
                        <label class="form-label fw-bold">NTC</label>
                        <div class="d-flex gap-2">
                            <div class="flex-fill">
                                <label for="MinNTC" class="form-label">Mínimo</label>
                                <input type="text" class="form-control" id="AddMinNTC">
                            </div>
                            <div class="flex-fill">
                                <label for="MaxNTC" class="form-label">Máximo</label>
                                <input type="text" class="form-control" id="AddMaxNTC">
                            </div>
                        </div>
                    </div>

                    <!-- INSIDE -->
                    <div class="form-group mb-3">
                        <label class="form-label fw-bold">Inside</label>
                        <div class="d-flex gap-2">
                            <div class="flex-fill">
                                <label for="MinInside" class="form-label">Mínimo</label>
                                <input type="text" class="form-control" id="AddMinINSIDE">
                            </div>
                            <div class="flex-fill">
                                <label for="MaxInside" class="form-label">Máximo</label>
                                <input type="text" class="form-control" id="AddMaxINSIDE">
                            </div>
                        </div>
                    </div>

                    <!-- OUTSIDE -->
                    <div class="form-group mb-3">
                        <label class="form-label fw-bold">Outside</label>
                        <div class="d-flex gap-2">
                            <div class="flex-fill">
                                <label for="MinOutside" class="form-label">Mínimo</label>
                                <input type="text" class="form-control" id="AddMinOUTSIDE">
                            </div>
                            <div class="flex-fill">
                                <label for="MaxOutside" class="form-label">Máximo</label>
                                <input type="text" class="form-control" id="AddMaxOUTSIDE">
                            </div>
                        </div>
                    </div>

                    <!-- GUARD -->
                    <div class="form-group mb-3">
                        <label class="form-label fw-bold">Guard</label>
                        <div class="d-flex gap-2">
                            <div class="flex-fill">
                                <label for="MinGuard" class="form-label">Mínimo</label>
                                <input type="text" class="form-control" id="AddMinGUARD">
                            </div>
                            <div class="flex-fill">
                                <label for="MaxGuard" class="form-label">Máximo</label>
                                <input type="text" class="form-control" id="AddMaxGUARD">
                            </div>
                        </div>
                    </div>




                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary" id="addParameters">Guardar</button>
            </div>
        </div>
    </div>
</div>


<div class="modal fade" id="EditParameterModal" tabindex="-1" role="dialog" aria-labelledby="DatePickerModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="DatePickerModalLabel">Editar parametros</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <form>
                    <p>Agregar 0 en el minimo y el maximo para ocultar parametro</p>
                    <div class="form-group  mb-3">
                        <label for="Program">Nombre programa:</label>
                        <select id="ProgramSelect" class="form-control">
                            <option value="" disabled selected>Seleccione una opción</option>
                            @foreach (var part in ViewBag.ProgramList as List<string>)
                            {
                                <option value="@part">@part</option>
                            }
                        </select>
                    </div>



                    <!-- HEADER -->
                    <div class="form-group mb-3">
                        <label class="form-label fw-bold">HEADER</label>
                        <div class="d-flex gap-2">
                            <div class="flex-fill">
                                <label for="MinHeader" class="form-label">Mínimo</label>
                                <input type="text" class="form-control" id="MinHEATER">
                            </div>
                            <div class="flex-fill">
                                <label for="MaxHeader" class="form-label">Máximo</label>
                                <input type="text" class="form-control" id="MaxHEATER">
                            </div>
                        </div>
                    </div>

                    <!-- NTC -->
                    <div class="form-group mb-3">
                        <label class="form-label fw-bold">NTC</label>
                        <div class="d-flex gap-2">
                            <div class="flex-fill">
                                <label for="MinNTC" class="form-label">Mínimo</label>
                                <input type="text" class="form-control" id="MinNTC">
                            </div>
                            <div class="flex-fill">
                                <label for="MaxNTC" class="form-label">Máximo</label>
                                <input type="text" class="form-control" id="MaxNTC">
                            </div>
                        </div>
                    </div>

                    <!-- INSIDE -->
                    <div class="form-group mb-3">
                        <label class="form-label fw-bold">Inside</label>
                        <div class="d-flex gap-2">
                            <div class="flex-fill">
                                <label for="MinInside" class="form-label">Mínimo</label>
                                <input type="text" class="form-control" id="MinINSIDE">
                            </div>
                            <div class="flex-fill">
                                <label for="MaxInside" class="form-label">Máximo</label>
                                <input type="text" class="form-control" id="MaxINSIDE">
                            </div>
                        </div>
                    </div>

                    <!-- OUTSIDE -->
                    <div class="form-group mb-3">
                        <label class="form-label fw-bold">Outside</label>
                        <div class="d-flex gap-2">
                            <div class="flex-fill">
                                <label for="MinOutside" class="form-label">Mínimo</label>
                                <input type="text" class="form-control" id="MinOUTSIDE">
                            </div>
                            <div class="flex-fill">
                                <label for="MaxOutside" class="form-label">Máximo</label>
                                <input type="text" class="form-control" id="MaxOUTSIDE">
                            </div>
                        </div>
                    </div>

                    <!-- GUARD -->
                    <div class="form-group mb-3">
                        <label class="form-label fw-bold">Guard</label>
                        <div class="d-flex gap-2">
                            <div class="flex-fill">
                                <label for="MinGuard" class="form-label">Mínimo</label>
                                <input type="text" class="form-control" id="MinGUARD">
                            </div>
                            <div class="flex-fill">
                                <label for="MaxGuard" class="form-label">Máximo</label>
                                <input type="text" class="form-control" id="MaxGUARD">
                            </div>
                        </div>
                    </div>




                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary" id="SaveParameters">Guardar</button>
            </div>
        </div>
    </div>
</div>



<div class="modal fade" id="DeleteParameterModal" tabindex="-1" role="dialog" aria-labelledby="DatePickerModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="DatePickerModalLabel">Eliminar</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <form>

                    <div class="form-group  mb-3">
                        <label for="Program">Nombre programa:</label>
                        <select id="ProgramSelectDelete" class="form-control">
                            <option value="" disabled selected>Seleccione una opción</option>
                            @foreach (var part in ViewBag.ProgramList as List<string>)
                            {
                                <option value="@part">@part</option>
                            }
                        </select>
                    </div>



                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-danger" id="DeleteParameters">Eliminar</button>
            </div>
        </div>
    </div>
</div>


<div class="modal fade" id="RenameParameterModal" tabindex="-1" role="dialog" aria-labelledby="DatePickerModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="DatePickerModalLabel">Renombrar Programa</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <form>

                    <div class="form-group mb-3">
                        <label for="ProgramSelectRename">Programa actual:</label>
                        <select id="ProgramSelectRename" class="form-control">
                            <option value="" disabled selected>Seleccione una opción</option>
                            @foreach (var part in ViewBag.ProgramList as List<string>)
                            {
                                <option value="@part">@part</option>
                            }
                        </select>
                    </div>

                    <div class="form-group mb-3">
                        <label for="NewProgramName">Nuevo nombre:</label>
                        <input type="text" class="form-control" id="NewProgramName" style="text-transform: uppercase;" placeholder="Ingrese el nuevo nombre">
                    </div>

                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-warning" id="RenameParameters">Renombrar</button>
            </div>
        </div>
    </div>
</div>


@section scripts {
    <script type="module" src="/lib/sweetalert2.all.min.js"></script>
    <script type="module" src="/js/parameters/main.js" asp-append-version="true"></script>
    <script>
        let table = $('#DataTable').DataTable({
             processing: true,
            serverSide: true,
            order: [[5, 'desc']],
            "pageLength": 15,
            "searching": false,
            "dom": 'Bfrtip',
            searching: false,
            ajax: {
                    url: '@Url.Action("SetTable", "ViewParameter")', // Cambia "TuControlador" por el nombre correcto
                    type: 'POST'
            },
            "buttons":[
                {
                            text: 'Agregar parametro',
                            className: 'btn btn-success mb-3',
                            action: function (e, dt, node, config) {
                            $('#CreateParameterModal').modal('show');
                            }
                },
                {
                            text: 'Editar parametro',
                            className: 'btn btn-info mb-3',
                            action: function (e, dt, node, config) {
                                $('#EditParameterModal').modal('show');
                            }
                },
                {
                            text: 'Eliminar parametro',
                            className: 'btn btn-danger mb-3',
                            action: function (e, dt, node, config) {
                                $('#DeleteParameterModal').modal('show');
                            }
                },
                {
                            text: 'Renombrar parametro',
                            className: 'btn btn-warning mb-3',
                            action: function (e, dt, node, config) {
                                $('#RenameParameterModal').modal('show');
                            }
                }

            ],
            columns: [
                    { data: 'program' },

                    { data: 'heaterMin', className: 'text-center' },
                    { data: 'heaterMax', className: 'text-center' },

                    { data: 'ntcMin',  className: 'text-center' },
                    { data: 'ntcMax',  className: 'text-center' },

                    { data: 'insideMin',  className: 'text-center' },
                    { data: 'insideMax',  className: 'text-center' },

                    { data: 'outsideMin', className: 'text-center' },
                    { data: 'outsideMax', className: 'text-center' },

                    { data: 'guardMin', className: 'text-center' },
                    { data: 'guardMax', className: 'text-center' },
                    
                ],
        
        });

             $(document).on('click', '.delete-button', function () {
