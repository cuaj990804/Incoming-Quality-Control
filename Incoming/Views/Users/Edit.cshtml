@model Incoming.Models.User

@{
    ViewData["Title"] = "Edit";
    Layout = null;
}


<div>
    <form asp-action="Edit" autocomplete="off">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <input type="hidden" asp-for="Id" />
        <div class="form-group">
            <label asp-for="EmployeeNumber" class="control-label"># Empleado</label>
            <input asp-for="EmployeeNumber" class="form-control" style="text-transform: uppercase;" />
            <span asp-validation-for="EmployeeNumber" class="text-danger"></span>
        </div>
        <div class="form-group">
            <label asp-for="FirstName" class="control-label">Nombre</label>
            <input asp-for="FirstName" class="form-control" />
            <span asp-validation-for="FirstName" class="text-danger"></span>
        </div>
        <div class="form-group">
            <label asp-for="LastName" class="control-label">Apellido</label>
            <input asp-for="LastName" class="form-control " style="text-transform: uppercase;" />
            <span asp-validation-for="LastName" class="text-danger"></span>
        </div>
        <div class="form-group">
            <label asp-for="Area" class="control-label">Área</label>
            <select asp-for="Area" id="RolSelect" class="form-control">
                <option value="" disabled selected>Seleccione una opción</option>
                <option value="IT">TI</option>
                <option value="PRODUCTION">PRODUCCION</option>
                <option value="QUALITY">CALIDAD</option>

            </select>
            <span asp-validation-for="Area" class="text-danger"></span>
        </div>
        <div class="form-group mb-4">
            <label asp-for="UserRole" class="control-label">Rol</label>
            <select asp-for="UserRole" id="RolSelect" class="form-control">
                <option value="" disabled selected>Seleccione una opción</option>
                <option value="ADMINISTRATOR">ADMINISTRADOR</option>
                <option value="SUPERVISOR">SUPERVISOR</option>
                <option value="USER">USUARIO</option>
                
            </select>
            <span asp-validation-for="UserRole" class="text-danger"></span>

        </div>
        <div class="form-group">
            <input type="submit" value="Editar" class="btn btn-primary" />
        </div>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
